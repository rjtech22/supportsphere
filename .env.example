# Public site URL used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase project settings (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC secret used to pseudonymize review submission fingerprints.
# Generate a long random value and never prefix it with NEXT_PUBLIC.
REVIEW_SPAM_SECRET=

# Long random secret used by Vercel Cron to call automation routes.
CRON_SECRET=

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Optional ad slot IDs. Leave blank until AdSense approves the site.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=

# Optional reporting connection. Dashboard stays empty until a safe importer is connected.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
